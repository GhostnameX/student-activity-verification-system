# ===== Shared env =====
BETTER_AUTH_SECRET=change-me-please
BETTER_AUTH_URL=http://localhost:3000

# ===== Database (Supabase pooler) =====
DATABASE_URL=postgresql://postgres.example:password@aws-0-region.pooler.supabase.com:6543/postgres

# ===== Supabase Storage =====
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# ===== Email (Resend) =====
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ===== Certificate PDF =====
CERTIFICATE_LOCATION=พิษณุโลก

# ===== API (Elysia) =====
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Your App <onboarding@resend.dev>

# ===== Web (SvelteKit) =====
PUBLIC_API_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_SUPABASE_ANON_KEY=anon-key
