# ===== Shared env =====
BETTER_AUTH_SECRET=change-me-please
BETTER_AUTH_URL=http://localhost:3000

# ===== Local database =====
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:8520/ua_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:8520/ua_roster_test
# Local remote maintenance is denied unless this is explicitly set to 1.
ALLOW_REMOTE_DATABASE=
# Production DATABASE_URL is configured in Render only.

# ===== Supabase Storage =====
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Production service-role credentials belong in Render. For explicit local
# storage maintenance only, use gitignored apps/api/.env.storage-prod.local.

# ===== Email (Resend) =====
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ===== Certificate PDF =====
CERTIFICATE_LOCATION=พิษณุโลก

# ===== API (Elysia) =====
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# ===== Web (SvelteKit) =====
PUBLIC_API_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_SUPABASE_ANON_KEY=anon-key
