    "build:check": "bun run build && bun scripts/check-dev-bypass.ts",
    "test:oauth-security": "bun test scripts/oauth-security.test.ts scripts/oauth-flow.security.test.ts",
    "storage:private-request-attachments": "bun scripts/configure-private-request-attachments.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.112.2",
    "@ua/db": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "elysia": "^1.2.5",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "bun-types": "^1.2.0"
  }
}
