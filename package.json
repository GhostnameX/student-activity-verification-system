{
  "name": "university-activity-requests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter @ua/web dev",
    "dev:api": "bun run --filter @ua/api dev",
    "dev": "bun run dev:api & bun run dev:web",
    "build": "bun run --filter @ua/db build && bun run --filter @ua/api build && bun run --filter @ua/web build",
    "build:web": "bun run --filter @ua/web build",
    "db:generate": "bun run --filter @ua/db generate",
    "db:migrate": "bun run --filter @ua/db migrate",
    "db:push": "bun run --filter @ua/db push",
    "db:seed": "bun run --filter @ua/db seed",
    "db:studio": "bun run --filter @ua/db studio"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "typescript": "^5.7.2"
  }
}
